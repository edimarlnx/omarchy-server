diff --git a/bin/omarchy-iso-make b/bin/omarchy-iso-make
index e8195b4..2fced3d 100755
--- a/bin/omarchy-iso-make
+++ b/bin/omarchy-iso-make
@@ -6,8 +6,20 @@ NO_CACHE=""
 KEEP_PKG_CACHE=""
 LOCAL_OMARCHY_PATH=""
 LOCAL_PKGS_PATH=""
+# Which edition of Omarchy this ISO installs. "desktop" is the stock build;
+# other values select a profile directory under <pkgs-checkout>/profile/<name>
+# carrying that edition's package lists (see builder/build-iso.sh).
+OMARCHY_PROFILE="${OMARCHY_PROFILE:-desktop}"
 while [[ $# -gt 0 ]]; do
   case $1 in
+  --profile)
+    OMARCHY_PROFILE="${2:-}"
+    if [[ -z $OMARCHY_PROFILE ]]; then
+      echo "Error: --profile requires a name (desktop, server, ...)" >&2
+      exit 1
+    fi
+    shift 2
+    ;;
   --no-cache)
     NO_CACHE=1
     shift
@@ -57,7 +69,7 @@ while [[ $# -gt 0 ]]; do
     ;;
   *)
     echo "Unknown option: $1"
-    echo "Usage: $0 [--no-cache] [--keep-pkg-cache] [--no-boot-offer] [--debug] [--edge] [--dev|--rc] [--local-source <omarchy-checkout> <pkgs-checkout>]"
+    echo "Usage: $0 [--no-cache] [--keep-pkg-cache] [--no-boot-offer] [--debug] [--edge] [--dev|--rc] [--profile <name>] [--local-source <omarchy-checkout> <pkgs-checkout>]"
     exit 1
     ;;
   esac
@@ -125,6 +137,7 @@ DOCKER_ARGS=(
   --privileged
   -e "OMARCHY_ISO_REF=$OMARCHY_ISO_REF"
   -e "OMARCHY_MIRROR=$OMARCHY_MIRROR"
+  -e "OMARCHY_PROFILE=$OMARCHY_PROFILE"
   -e "OMARCHY_INSTALL_DEBUG=${OMARCHY_INSTALL_DEBUG:-}"
   -e "HOST_UID=$(id -u)"
   -e "HOST_GID=$(id -g)"
@@ -149,7 +162,13 @@ fi
 # Mount the build cache directory where packages are downloaded. Channels use
 # different package snapshots and must never share an offline mirror cache.
 if [[ -z "$NO_CACHE" ]]; then
-  OFFLINE_REPO_BUILD_CACHE_DIR="$HOME/.cache/omarchy/iso_${OMARCHY_MIRROR}/airootfs/var/cache/omarchy"
+  # Profiles select different package lists, and the mirror is pruned down to
+  # exactly the selection of the build that ran last. Sharing one cache
+  # directory between profiles would make every build re-download the other
+  # profile's packages, so key the cache by profile as well as by channel.
+  CACHE_KEY="iso_${OMARCHY_MIRROR}"
+  [[ $OMARCHY_PROFILE != "desktop" ]] && CACHE_KEY="${CACHE_KEY}_${OMARCHY_PROFILE}"
+  OFFLINE_REPO_BUILD_CACHE_DIR="$HOME/.cache/omarchy/$CACHE_KEY/airootfs/var/cache/omarchy"
   mkdir -p "$OFFLINE_REPO_BUILD_CACHE_DIR"
   DOCKER_ARGS+=(-v "$OFFLINE_REPO_BUILD_CACHE_DIR:/var/cache/airootfs/var/cache/omarchy")
 else
@@ -162,6 +181,9 @@ docker run "${DOCKER_ARGS[@]}" archlinux/archlinux:latest /$BUILD_SCRIPT
 
 latest_iso=$(\ls -t "$BUILD_RELEASE_PATH"/*.iso | head -n1)
 iso_ref="${latest_iso%.*}-$OMARCHY_ISO_REF.iso"
+if [[ $OMARCHY_PROFILE != "desktop" ]]; then
+  iso_ref="${latest_iso%.*}-$OMARCHY_PROFILE-$OMARCHY_ISO_REF.iso"
+fi
 mv -f "$latest_iso" "$iso_ref"
 
 if [[ -z "${NO_BOOT_OFFER:-}" ]]; then
