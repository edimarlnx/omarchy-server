-if [[ -d /omarchy-source ]]; then
+if [[ -n $profile_dir ]]; then
+  # A named profile owns its package lists outright. The base list is what the
+  # orchestrator reads back as omarchy-base.packages at install time; the
+  # "other" list (packages bundled but not installed) is optional and defaults
