 : "${OMARCHY_NVIM_PACKAGE:=omarchy-nvim}"
 export OMARCHY_RUNTIME_PACKAGE OMARCHY_SETTINGS_PACKAGE OMARCHY_NVIM_PACKAGE
 
+# ─────────────────────────────────────────────────────────────────────────────
+# Profile: which edition of Omarchy this ISO installs. "desktop" is the stock
+# build and changes nothing. A named profile lives in the local pkgs checkout
+# at /omarchy-pkgs/profile/<name>/ and supplies its own archinstall package
+# list and base package list, plus the Omarchy package names to build and
+# install. OMARCHY_EXTRA_PACKAGES names further packages built from that
+# checkout (a profile's own keyring, say) which must land in the offline
+# mirror without ever being looked up on the network mirror.
+#
+# A profile target may be empty (the server profile ships no nvim package):
+# empty names are dropped everywhere instead of being special-cased.
+# ─────────────────────────────────────────────────────────────────────────────
+OMARCHY_PROFILE="${OMARCHY_PROFILE:-desktop}"
+OMARCHY_EXTRA_PACKAGES="${OMARCHY_EXTRA_PACKAGES:-}"
+profile_dir=""
+archinstall_packages_file=/builder/archinstall.packages
+
+if [[ $OMARCHY_PROFILE != "desktop" ]]; then
+  profile_dir="/omarchy-pkgs/profile/$OMARCHY_PROFILE"
+  if [[ ! -d $profile_dir ]]; then
+    echo "ERROR: profile '$OMARCHY_PROFILE' selected but $profile_dir is not mounted." >&2
+    echo "       Named profiles require --local-source with a pkgs checkout that" >&2
+    echo "       carries profile/$OMARCHY_PROFILE/." >&2
+    exit 1
+  fi
+  [[ -f $profile_dir/archinstall.packages ]] && archinstall_packages_file="$profile_dir/archinstall.packages"
+fi
+
+case "$OMARCHY_PROFILE" in
+  desktop) ;;
+  server)
+    OMARCHY_RUNTIME_PACKAGE=omarchy-server
+    OMARCHY_SETTINGS_PACKAGE=omarchy-server-settings
+    # No editor package: `nano` comes from the profile's archinstall.packages.
+    OMARCHY_NVIM_PACKAGE=""
+    # Signs the future [omarchy-server] repository; a hard dependency of the
+    # runtime package, so the offline mirror has to carry it.
+    OMARCHY_EXTRA_PACKAGES="omarchy-server-keyring"
+    ;;
+  *)
+    echo "ERROR: unknown profile: $OMARCHY_PROFILE" >&2
+    exit 1
+    ;;
+esac
+export OMARCHY_RUNTIME_PACKAGE OMARCHY_SETTINGS_PACKAGE OMARCHY_NVIM_PACKAGE
+export OMARCHY_PROFILE OMARCHY_EXTRA_PACKAGES
+
+# Every Omarchy package built from the local checkouts, with empty names
+# dropped. Used for the local build, for excluding them from the online
+# download, and for adding their artifacts back to the mirror keep-set.
+local_package_names=()
+for name in $OMARCHY_RUNTIME_PACKAGE $OMARCHY_SETTINGS_PACKAGE \
+  $OMARCHY_NVIM_PACKAGE $OMARCHY_EXTRA_PACKAGES; do
+  local_package_names+=("$name")
+done
+
 # Packages installed into the Arch container used to build the ISO.
 pacman-key --init
 pacman --noconfirm -Sy archlinux-keyring
@@ -72,6 +128,10 @@ OMARCHY_RUNTIME_PACKAGE=$OMARCHY_RUNTIME_PACKAGE
