+# ─────────────────────────────────────────────────────────────────────────────
+# Install profile. Written into the ISO by builder/build-iso.sh; an autoinstall
+# drive can override it with a `profile` file (omarchy-cidata-load copies it to
+# /root). "desktop" is the stock edition and changes nothing here.
+#
+# The profile decides which phases apply (a headless machine has no hibernation
+# and no display manager) and is exported into the target chroot as
+# OMARCHY_PROFILE, which omarchy-apply-system and omarchy-provision-user read
+# to pick their setup tree.
+# ─────────────────────────────────────────────────────────────────────────────
+
+DEFAULT_PROFILE = "desktop"
+
+
+def _install_profile() -> str:
+    if value := os.environ.get("OMARCHY_PROFILE"):
+        return value.strip() or DEFAULT_PROFILE
+
+    for path in (Path("/root/profile"), Path("/usr/share/omarchy-iso/profile")):
+        try:
+            if value := path.read_text().strip():
+                return value
+        except OSError:
+            continue
+
+    return DEFAULT_PROFILE
+
+
+def _is_server_profile() -> bool:
+    return _install_profile() == "server"
+
+
