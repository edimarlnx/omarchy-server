+# ─────────────────────────────────────────────────────────────────────────────
+# install_addons: apply the optional package sets named by the autoinstall
+# drive's `addons` file (one name per line). Server profile only — it is the
+# profile whose base is deliberately too small to be useful for everything, so
+# it is the profile that needs a supported way to add things back.
+#
+# Runs right after omarchy-apply-system, and therefore before
+# finalize_limine_boot, so an addon whose packages trigger an initramfs rebuild
+# is still followed by the final UKI build, and before create_factory_snapshot,
+# so the addons are part of what a factory reset restores.
+# ─────────────────────────────────────────────────────────────────────────────
+
+ADDON_NAME_RE = re.compile(r"[a-z0-9][a-z0-9-]*\Z")
+
+
+def _requested_addons() -> list[str]:
+    """Read /root/addons, which omarchy-cidata-load copies off the drive.
+
+    Names are validated rather than trusted: they become an argument to a
+    command run as root in the target, and the file comes from a removable
+    drive.
+    """
+    try:
+        lines = Path("/root/addons").read_text().splitlines()
+    except OSError:
+        return []
+
+    names = []
+    for line in lines:
+        name = line.strip()
+        if not name or name.startswith("#"):
+            continue
+        if not ADDON_NAME_RE.match(name):
+            raise RuntimeError(f"invalid addon name on the autoinstall drive: {name!r}")
+        names.append(name)
+    return names
+
+
+def install_addons(ctx: InstallContext) -> None:
+    if not _is_server_profile():
+        return
+
+    addons = _requested_addons()
+    if not addons:
+        return
+
+    _prepare_target_setup(ctx)
+
+    # omarchy-apply-system's last step restores the channel's online
+    # pacman.conf, but the addon packages live in the ISO's offline mirror.
+    # Hand pacman the live environment's offline configuration for the length
+    # of this phase and take it away again afterwards, so the installed system
+    # is left pointing at the online mirrors as it was.
+    offline_conf = ctx.target / "etc" / "pacman.conf.omarchy-offline"
+    shutil.copy("/etc/pacman.conf", str(offline_conf))
+    os.environ["OMARCHY_ADDON_PACMAN_CONF"] = "/etc/pacman.conf.omarchy-offline"
+
+    try:
+        for addon in addons:
+            info(f"› installing addon: {addon}")
+            _run_target_setup_command(ctx, ["/usr/bin/omarchy-server-addon", addon])
+    finally:
+        os.environ.pop("OMARCHY_ADDON_PACMAN_CONF", None)
+        offline_conf.unlink(missing_ok=True)
+
+    # The addon packages landed in the target's package cache, which is on the
+    # snapshotted subvolume: prune again so the factory snapshot is taken on a
+    # clean disk, exactly as install/server/prune-pkg-cache-server.sh does at
+    # the end of the system setup that ran before this.
+    subprocess.run(
+        ["arch-chroot", str(ctx.target), "bash", "-c",
+         "paccache -rk1 || true; paccache -ruk0 || true"],
+        check=False,
+    )
+
