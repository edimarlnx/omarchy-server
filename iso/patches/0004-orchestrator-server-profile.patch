+def _write_profile_marker(ctx: InstallContext) -> None:
+    """Persist the profile in the target before any setup command runs.
+
+    omarchy-apply-system reads OMARCHY_PROFILE from the environment, which the
+    chroot env carries, but every later run on the installed machine
+    (omarchy-update, a manual re-apply) has only this file to go on.
+    """
+    profile = _install_profile()
+    marker = ctx.target / "etc" / "omarchy-profile"
+    marker.parent.mkdir(parents=True, exist_ok=True)
+    marker.write_text(profile + "\n")
+
+
 def run_system_finalizer(ctx: InstallContext) -> None:
