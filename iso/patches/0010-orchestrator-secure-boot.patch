+# ─────────────────────────────────────────────────────────────────────────────
+# enroll_secure_boot: hand this machine's PK/KEK/db to the firmware.
+#
+# Last, and after validate_boot, on purpose. Enrolling a platform key is the
+# moment the firmware starts refusing everything it cannot verify, so it must
+# come after the boot chain exists, has been signed and has been checked --
+# `omarchy-server-secureboot enroll` re-verifies with `sbctl verify` before it
+# writes anything, and refuses to enroll into a chain that is not fully signed.
+#
+# Enrollment writes EFI variables, not files, so it does not belong inside the
+# factory snapshot that follows either way.
+#
+# Firmware that is not in Setup Mode is not a failure: the command says what to
+# do at the machine's own setup screen and exits 0, leaving an install that is
+# signed and ready for the operator's one manual step.
+# ─────────────────────────────────────────────────────────────────────────────
+
+def enroll_secure_boot(ctx: InstallContext) -> None:
+    if not _secure_boot_requested():
+        return
+
+    # The real file under /usr/share, not the /usr/bin symlink: that symlink is
+    # absolute, so resolving it from outside the chroot lands in the LIVE ISO's
+    # filesystem, where the command does not exist — and the phase would fail
+    # on a target where the addon installed perfectly.
+    if not (ctx.target / "usr/share/omarchy/bin/omarchy-server-secureboot").exists():
+        raise RuntimeError(
+            "secure boot was requested but omarchy-server-secureboot is not in the "
+            "target; the `secureboot` addon did not install"
+        )
+
+    _prepare_target_setup(ctx)
+    _run_target_setup_command(ctx, ["/usr/bin/omarchy-server-secureboot", "enroll"])
+
+
