+# ─────────────────────────────────────────────────────────────────────────────
+# Secure Boot. A marker file on the autoinstall drive (`secureboot`, copied to
+# /root by omarchy-cidata-load) or OMARCHY_SECURE_BOOT=1 in the live
+# environment asks for an install whose boot chain is signed by keys this
+# machine generates for itself.
+#
+# It is not a phase of its own for the setup: the work is the server profile's
+# `secureboot` addon, so it rides the addon phase that already exists and
+# already knows how to install a package out of the offline mirror. That phase
+# runs before finalize_limine_boot, which is what the ordering has to be --
+# the kernel cmdline lives inside the UKI, so the drop-in that adds
+# `lockdown=integrity` must exist before the UKI is built.
+#
+# Enrollment IS a phase of its own (enroll_secure_boot, below), because it can
+# only happen after the boot chain has been written and signed.
+# ─────────────────────────────────────────────────────────────────────────────
+
+SECURE_BOOT_ADDON = "secureboot"
+
+
+def _secure_boot_requested() -> bool:
+    if not _is_server_profile():
+        return False
+    if os.environ.get("OMARCHY_SECURE_BOOT", "").strip() == "1":
+        return True
+    return Path("/root/secureboot").exists()
+
+
 # Packages installed BEFORE useradd. The selected omarchy-settings package and
 # omarchy-nvim populate /etc/skel so the user's home gets seeded correctly, and
 # omarchy-settings also ships the limine/snapper configs. Target-side setup
@@ -1168,6 +1196,10 @@ def _run_target_setup_command(ctx: InstallContext, cmd: list[str], *, user: str
         # turns the daily update timer on when it says 1; the package ships
         # that timer disabled.
         f"OMARCHY_UNATTENDED_UPDATES={'1' if Path('/root/unattended-updates').exists() else '0'}",
+        # Same shape: a marker file on the autoinstall drive. The setup itself
+        # runs as the `secureboot` addon; this is what lets anything else in
+        # the target know which kind of install it is part of.
+        f"OMARCHY_SECURE_BOOT={'1' if _secure_boot_requested() else '0'}",
         "OMARCHY_INSTALL_LOG_FILE=/var/log/omarchy-install.log",
         "OMARCHY_LOG_TO_STDOUT=1",
     ]
