# VM images, NVRAM, keys and build output never enter the repo.
*.qcow2
*.img
*.iso
*_VARS.fd
pocs/**/keys/
pocs/**/out/
pocs/**/out-*/
temp/
upstream/

# Package build (pkgs/): signing keys, makepkg output, the assembled repo and
# the scratch dir used to dissect the published upstream packages.
pkgs/keys/*
!pkgs/keys/gen-lab-key.sh
pkgs/out/
pkgs/repo/
pkgs/scratch/
# Generated by pkgs/build.sh and pkgs/keys/gen-lab-key.sh.
pkgs/pkgbuilds/*/omarchy-server-overlay.tar.gz
pkgs/pkgbuilds/omarchy-server-keyring/omarchy-server.gpg
pkgs/pkgbuilds/omarchy-server-keyring/omarchy-server-trusted
pkgs/pkgbuilds/omarchy-server-keyring/omarchy-server-revoked

# ISO build (iso/): scratch copy of upstream/omarchy-iso plus the assembled
# package source tree, and the built ISOs. Both are build output.
iso/scratch/
iso/release/
