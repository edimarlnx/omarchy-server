# VM images, NVRAM, keys and build output never enter the repo.
*.qcow2
*.img
*.iso
*_VARS.fd
pocs/**/keys/
pocs/**/out/
pocs/**/out-*/
temp/
upstream/

# Package build (pkgs/): signing keys, makepkg output, the assembled repo and
# the scratch dir used to dissect the published upstream packages. The
# PKGBUILDs themselves are not here at all -- they live in the sibling
# omarchy-server-pkgs checkout (see docs/packaging.md).
pkgs/keys/*
!pkgs/keys/gen-lab-key.sh
pkgs/out/
pkgs/repo/
pkgs/scratch/

# ISO build (iso/): scratch copy of upstream/omarchy-iso plus the assembled
# package source tree, and the built ISOs. Both are build output.
iso/scratch/
iso/release/

# serverlab: the compiled driver and the log of every run it makes. The source
# is tools/serverlab/; `make serverlab` rebuilds the binary.
bin/
pocs/lab/runs/
